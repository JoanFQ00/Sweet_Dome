  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Gener\xF3 miedo e inseguridad para que los habitantes se fueran
    a su nuevo \u201Chogar\u201D."
--- !u!114 &2509891011282525552
MonoBehaviour:
  m_ObjectHideFlags: 1
