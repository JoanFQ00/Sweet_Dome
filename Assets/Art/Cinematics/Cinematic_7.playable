--- !u!114 &6940184226847206707
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Pero un d\xEDa el se\xF1or Helbert se llev\xF3 a su hijo a la f\xE1brica,
    con la desgracia de que el ni\xF1o cay\xF3 en uno de sus tanques."
--- !u!114 &6955888770852084981
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "El Presidente los llama \u201Crebeldes\u201D, pero no es verdad,
    los estais matando a todos."
--- !u!114 &7315997620399469806
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Gener\xF3 miedo e inseguridad para que los habitantes se fueran
    a su nuevo \u201Chogar\u201D."
--- !u!114 &7398644572400627748
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: Muchos se quedaron en Bu-Bop-A-Lula, pero otros como tus padres se
    fueron a Sweet Dome.
