  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Se pensaron que morir\xEDa, pero averiguaron que suministrando KZ-350
    diariamente cada vez se hac\xEDa m\xE1s fuerte."
