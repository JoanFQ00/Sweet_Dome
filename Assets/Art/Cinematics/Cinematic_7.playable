  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "El Presidente los llama \u201Crebeldes\u201D, pero no es verdad,
    los estais matando a todos."
--- !u!114 &-1158162577507607054
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Ten\xEDa una f\xE1brica de Cadillacs y encontr\xF3 en las profundidades
    de las monta\xF1as un l\xEDquido rosa que hac\xEDa que sus coches tuvieran m\xE1s
    potencia."
--- !u!114 &-1105894666167941559
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Toda la energ\xEDa que sac\xE1is de las monta\xF1as est\xE1 dejando
    sin recursos a los habitantes de fuera de la c\xFApula"
--- !u!114 &-793947835736706397
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
