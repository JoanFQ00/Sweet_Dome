  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: Muchos se quedaron en Bu-Bop-A-Lula, pero otros como tus padres se
    fueron a Sweet Dome.
--- !u!114 &949860899150242873
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Esta c\xFApula nos separa de Be-Bop-A-Lula, la ciudad donde naciste,
    al igual que el Presidente"
--- !u!114 &1725926265186642888
