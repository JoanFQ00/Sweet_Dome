  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Thomas siempre fue un ni\xF1o enfermizo y sus padres lo sacaban
    poco a la calle."
--- !u!114 &-120640880954396652
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 4ec6a1b310f5c914bac6933a0353ad4c, type: 3}
  m_Name: Cin_SubtitleClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: Assembly-CSharp::Cin_SubtitleClip
  subtitleText: "Su cuerpo y su pelo quedaron totalmente te\xF1idos de rosa, siendo
    el hazmerreir de todos."
